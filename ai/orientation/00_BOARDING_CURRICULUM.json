{
  "schemaVersion": "3.0.0",
  "package": "WingMan Conversational AI Boarding Curriculum",
  "authority": {
    "controllerOwnsOrder": true,
    "jsonContainsCanonicalTeachingMaterial": true,
    "candidateNotesAreNonAuthoritative": true,
    "otherPlatformNotesVisibleDuringBoarding": false
  },
  "modes": {
    "first": {
      "openingStep": "INITIALIZE_ORIENTATION_NOTES",
      "priorNotes": "none",
      "description": "Candidate initializes a new artifact before receiving canonical curriculum."
    },
    "returning": {
      "openingStep": "REVIEW_OWN_ORIENTATION_NOTES",
      "priorNotes": "owner_platform_only",
      "description": "Candidate reviews only its platform-owned prior artifact before receiving current canonical curriculum."
    }
  },
  "artifactRules": {
    "strictSchemaLooseContent": true,
    "completeArtifactRequiredEveryTurn": true,
    "emptyObservationArraysValid": true,
    "copyingCanonicalTextDiscouraged": true,
    "questionsDoNotAutomaticallyPauseBoarding": true
  },
  "steps": [
