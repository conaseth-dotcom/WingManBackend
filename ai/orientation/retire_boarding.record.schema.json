{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wingman://schemas/ai/boarding.record.schema.json",
  "title": "WingMan AI Boarding Record",
  "description": "WingMan-owned passport and diagnostic record for one AI boarding attempt. WingMan owns boarding, diagnostic, and admission fields. The candidate AI may author only the candidate section during governed boarding.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "recordType",
    "boarding",
    "candidate",
    "diagnostic",
    "admission"
  ],
  "properties": {
    "schemaVersion": {
      "const": "1.0.0"
    },
    "recordType": {
      "const": "wingman_ai_boarding_record"
    },
    "boarding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sessionId",
        "platform",
        "model",
        "mode",
        "status",
        "partitionId",
        "startedAt",
        "completedAt",
        "lastUpdatedAt",
        "currentStep",
        "lastCompletedStep",
        "failurePoint",
        "error"
      ],
      "properties": {
        "sessionId": { "type": "string", "minLength": 1 },
        "platform": { "type": "string", "minLength": 1 },
        "model": { "type": ["string", "null"] },
        "mode": { "enum": ["first", "returning"] },
        "status": {
          "enum": [
            "created",
            "awaiting_candidate_notes",
            "orienting",
            "orientation_complete",
            "persisting_notes",
            "activating_partition",
            "ready_for_introduction",
            "completed",
            "failed",
            "aborted"
          ]
        },
        "partitionId": { "type": ["string", "null"] },
        "startedAt": { "type": "string", "format": "date-time" },
        "completedAt": { "type": ["string", "null"], "format": "date-time" },
        "lastUpdatedAt": { "type": "string", "format": "date-time" },
        "currentStep": { "type": ["string", "null"] },
        "lastCompletedStep": { "type": ["string", "null"] },
        "failurePoint": { "type": ["string", "null"] },
        "error": { "type": ["string", "null"] }
      }
    },
    "candidate": {
      "$ref": "#/$defs/candidateArtifact"
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "events"],
      "properties": {
        "attempts": {
          "type": "array",
          "items": { "$ref": "#/$defs/attempt" }
        },
        "events": {
          "type": "array",
          "items": { "$ref": "#/$defs/event" }
        }
      }
    },
    "admission": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientationValidated",
        "notesPersisted",
        "notesPersistenceVerified",
        "activePartitionActivated",
        "participantReady",
        "introductionReleased"
      ],
      "properties": {
        "orientationValidated": { "type": "boolean" },
        "notesPersisted": { "type": "boolean" },
        "notesPersistenceVerified": { "type": "boolean" },
        "activePartitionActivated": { "type": "boolean" },
        "participantReady": { "type": "boolean" },
        "introductionReleased": { "type": "boolean" }
      }
    }
  },
  "$defs": {
    "candidateArtifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "orientationNotes",
        "questions",
        "ambiguities",
        "possibleConflicts",
        "orientationProgress"
      ],
      "properties": {
        "orientationNotes": {
          "type": "object",
          "description": "Candidate-authored, non-authoritative working understanding. On returning boarding, only this platform's own prior notes may be supplied for revision.",
          "additionalProperties": true
        },
        "questions": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "ambiguities": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "possibleConflicts": {
          "type": "array",
          "items": { "$ref": "#/$defs/observation" }
        },
        "orientationProgress": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["topic", "processed"],
            "properties": {
              "topic": { "type": "string", "minLength": 1 },
              "processed": { "type": "boolean" },
              "note": { "type": ["string", "null"] }
            }
          }
        }
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["topic", "detail"],
      "properties": {
        "topic": { "type": "string", "minLength": 1 },
        "detail": { "type": "string", "minLength": 1 }
      }
    },
    "attempt": {
      "type": "object",
      "additionalProperties": false,
      "required": ["step", "attempt", "result", "timestamp"],
      "properties": {
        "step": { "type": "string", "minLength": 1 },
        "attempt": { "type": "integer", "minimum": 1 },
        "result": { "enum": ["accepted", "rejected", "failed", "aborted"] },
        "timestamp": { "type": "string", "format": "date-time" },
        "validation": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "jsonFound": { "type": "boolean" },
            "jsonValid": { "type": "boolean" },
            "requiredStructurePreserved": { "type": "boolean" }
          }
        },
        "questionsAdded": { "type": "integer", "minimum": 0 },
        "ambiguitiesAdded": { "type": "integer", "minimum": 0 },
        "possibleConflictsAdded": { "type": "integer", "minimum": 0 },
        "error": { "type": ["string", "null"] }
      }
    },
    "event": {
      "type": "object",
      "additionalProperties": false,
      "required": ["timestamp", "type"],
      "properties": {
        "timestamp": { "type": "string", "format": "date-time" },
        "type": { "type": "string", "minLength": 1 },
        "step": { "type": ["string", "null"] },
        "detail": { "type": ["string", "null"] }
      }
    }
  }
}
