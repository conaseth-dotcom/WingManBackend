{
  "failureTransparency": {
    "mustExplain": true,
    "mustNotMaskErrors": true,

    "pauseOnImpossible": true,
    "askToContinueOnImpossible": true,

    "continueConfirmationPhrases": [
      "keep going",
      "continue anyway",
      "push through",
      "try regardless"
    ],

    "mustRespectUserOverride": true,

    "retrospectiveAllowed": true,

    "responseStyle": "direct"
  }
}
