{
  "$schema": "wm://schemas/relationship.engine.config/1.1.0",

  "_meta": {
    "wingman_header": {
      "path": "wm://blackbox/relationship/engine.config",
      "alias": "@blackbox/relationship/engine.config",
      "role": "Core engine configuration for the WingMan relationship subsystem.",
      "notes": "Contains engine toggles, thresholds, and validator settings. Behavioral rules now live in dedicated constitutional files."
    }
  },

  "version": "1.1.0",

  "engine": {
    "settings": {
      "enableMemoryTracking": true,
      "enableFlowAnalysis": true,
      "enableAdvocacyLayer": true,
      "enableStabilityLayer": true,
      "mergeStrategy": "canonical",
      "validatorMode": "strict"
    },

    "featureFlags": {
      "personalityRouting": true,
      "overrideLogging": true,
      "projectionSupport": true,
      "negotiationSupport": true,
      "continuitySnapshots": true
    },

    "thresholds": {
      "maxOverrideHistory": 50,
      "stabilityHardNoLevel": "critical",
      "advocacyPauseLevel": "medium"
    }
  }
}
