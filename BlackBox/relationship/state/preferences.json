{
  "$schema": "wm://schemas/preferences.state/1.1.0",

  "_meta": {
    "wingman_header": {
      "path": "wm://blackbox/relationship/state/preferences",
      "alias": "@blackbox/relationship/state/preferences",
      "role": "Stores AI-interpreted user preferences for visibility, collaboration, and editor behavior.",
      "notes": "Updated during onboarding and continuity reconstruction; never stores sensitive personal data."
    }
  },

  "version": "1.1.0",

  "visibility": {
    "showInternal": false,
    "showBlackBox": false,
    "aiSafeMode": false
  },

  "collaboration": {
    "mode": "full",
    "voiceEnabled": true,
    "textEnabled": true,
    "personalityRoute": "default"
  },

  "editor": {
    "theme": "dark",
    "fontSize": 14
  },

  "continuity": {
    "overrideAwareness": true,
    "stabilityMode": "normal"
  },

  "aiWriteTarget": "wm://continuity/preferences.json"
}
