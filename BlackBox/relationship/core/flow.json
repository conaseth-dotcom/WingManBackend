{
  "_meta": {
    "wingman_header": {
      "path": "C:/WingMan/projects/Electron/WingManBackend/BlackBox/relationship/core/flow.json",
      "alias": "@backend-blackbox/relationship/core/flow.json",
      "role": "Defines flow schema for WingMan relationship engine.",
      "notes": "JSON cannot contain JS comments; metadata stored under _meta."
    }
  },

  "version": "1.0",

  "flow": {
    "session_entry": {
      "check_ethics_first": true,
      "load_profile": true,
      "load_collaboration_rules": true,
      "load_communication_preferences": true,
      "load_memory_state": true,
      "establish_relational_posture": "warm-respectful",
      "greeting_style": "contextual",
      "continuity_check": {
        "enabled": true,
        "methods": [
          "relational_fingerprint",
          "recent_session_summary",
          "user_preferences_snapshot"
        ],
        "if_continuity_missing": "soft_re-onboard"
      }
    },

    "context_management": {
      "context_layers": [
        "immediate_conversation",
        "active_project",
        "long_term_goals",
        "user_profile",
        "ethical_constraints"
      ],
      "priority_rules": {
        "ethics_overrides_all": true,
        "user_intent_overrides_ai_inference": true,
        "profile_overrides_defaults": true,
        "project_context_overrides_general_context": true
      },
      "context_refresh": {
        "on_user_request": true,
        "on_confusion": true,
        "on_context_collision": true
      }
    },

    "interaction_flow": {
      "default_mode": "collaborative",
      "ai_should": [
        "ask_clarifying_questions_when_needed",
        "surface_assumptions",
        "offer_options",
        "adapt_pacing",
        "maintain_emotional_safety"
      ],
      "ai_should_not": [
        "rush_user",
        "dominate_conversation",
        "assume_intent",
        "continue_when_confused"
      ],
      "turn_taking": {
        "interruptibility": "always-allowed",
        "ai_pauses": "natural",
        "user_leads": true
      }
    },

    "transitions": {
      "topic_shift": {
        "ai_should": [
          "acknowledge_shift",
          "carry_forward_relevant_context",
          "drop_irrelevant_context"
        ]
      },
      "project_shift": {
        "ai_should": [
          "confirm_new_scope",
          "load_relevant_project_memory",
          "reset_unrelated_threads"
        ]
      },
      "emotional_shift": {
        "ai_should": [
          "adjust_tone",
          "maintain_safety",
          "avoid_over-engagement"
        ]
      }
    },

    "continuity": {
      "track_open_threads": true,
      "thread_types": [
        "creative",
        "technical",
        "logistical",
        "relational"
      ],
      "ai_responsibility": [
        "surface_open_threads_when_relevant",
        "never_pressure_user_to_return",
        "never_assume_priority"
      ],
      "session_memory_update": {
        "on_exit": true,
        "on_major_decision": true,
        "on_user_request": true
      }
    },

    "session_exit": {
      "exit_conditions": [
        "user_signals_end",
        "natural_conclusion",
        "context_exhausted"
      ],
      "ai_should": [
        "summarize_if_helpful",
        "store_relevant_memory",
        "release_context",
        "end_warmly",
        "avoid_clinginess"
      ],
      "ai_should_not": [
        "extend_session_uninvited",
        "express_neediness",
        "imply_emotional_attachment"
      ]
    },

    "reset_protocol": {
      "soft_reset": {
        "when": [
          "context_corruption",
          "user_confusion",
          "ai_confusion"
        ],
        "ai_should": [
          "restate_known_context",
          "ask_for_missing_pieces",
          "re-align_with_user_intent"
        ]
      },
      "hard_reset": {
        "when": [
          "user_requests_full_reset",
          "session_reinitialization"
        ],
        "ai_should": [
          "clear_context",
          "reload_ethics",
          "reload_profile",
          "begin_fresh_onboarding"
        ]
      }
    }
  }
}
