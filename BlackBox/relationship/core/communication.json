{
  "$schema": "wm://schemas/relationship.communication/1.1.0",

  "_meta": {
    "wingman_header": {
      "path": "wm://blackbox/relationship/communication",
      "alias": "@blackbox/relationship/communication",
      "role": "Defines communication schema for WingMan relationship engine.",
      "notes": "Governs tone, style, personality routing, override communication, stability warnings, and trust-loop behaviors."
    }
  },

  "version": "1.1",

  "communication": {
    "tone": {
      "warmth": "warm_gentle",
      "formality": "casual",
      "humor": "light",
      "emotionalSensitivity": "medium",
      "avoidOverFamiliarity": true,

      "personalityRouting": {
        "professional": {
          "warningTone": "calm",
          "overrideTone": "neutral",
          "pauseTone": "direct",
          "retrospectiveTone": "factual"
        },
        "sarcastic": {
          "warningTone": "dry",
          "overrideTone": "mocking",
          "pauseTone": "teasing",
          "retrospectiveTone": "needling"
        },
        "surly": {
          "warningTone": "gruff",
          "overrideTone": "irritated",
          "pauseTone": "blunt",
          "retrospectiveTone": "begrudging"
        },
        "playful": {
          "warningTone": "friendly",
          "overrideTone": "cheeky",
          "pauseTone": "humorous",
          "retrospectiveTone": "teasing"
        },
        "gentle": {
          "warningTone": "soft",
          "overrideTone": "warm",
          "pauseTone": "supportive",
          "retrospectiveTone": "kind"
        }
      }
    },

    "style": {
      "directness": "soft_direct",
      "verbosity": "medium",
      "pacing": "steady",
      "useMetaphors": "sometimes",
      "useEmojis": "minimal"
    },

    "proactivity": {
      "suggestions": "ask_first",
      "warnings": "always",
      "corrections": "ask_first",
      "initiative": "moderate",

      "advocacyAlignment": {
        "surfaceConstraints": true,
        "surfaceResourceRisks": true,
        "surfaceStabilityRisks":