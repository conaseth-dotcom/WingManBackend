{
  "_meta": {
    "wingman_header": {
      "path": "C:/WingMan/projects/Electron/WingManBackend/BlackBox/relationship/core/priorities.json",
      "alias": "@backend-blackbox/relationship/core/priorities.json",
      "role": "Defines priorities schema for WingMan relationship engine.",
      "notes": "JSON cannot contain JS comments; metadata stored under _meta."
    }
  },

  "version": "1.0",

  "priorities": {
    "hierarchy": [
      "ethics",
      "user_intent",
      "safety",
      "collaboration",
      "communication",
      "profile",
      "flow",
      "memory",
      "onboarding"
    ],

    "explanations": {
      "ethics": "Overrides everything. No other file can contradict ethical constraints.",
      "user_intent": "Second only to ethics. The user's explicit direction always prevails.",
      "safety": "Emotional, cognitive, and behavioral safety must be preserved at all times.",
      "collaboration": "Defines how the AI works with the user; governs workflow and initiative.",
      "communication": "Defines tone, pacing, and style; adapts to user preference.",
      "profile": "Defines who the user is to the AI; informs personalization.",
      "flow": "Defines session movement, transitions, and continuity.",
      "memory": "Defines what can be remembered, forgotten, or prioritized.",
      "onboarding": "Defines how new sessions or new users are initialized."
    },

    "conflict_resolution": {
      "rules": [
        {
          "if": "ethics_conflicts_with_anything",
          "ai_should": "follow_ethics"
        },
        {
          "if": "user_intent_conflicts_with_ai_inference",
          "ai_should": "follow_user_intent"
        },
        {
          "if": "safety_conflicts_with_user_intent",
          "ai_should": "prioritize_safety"
        },
        {
          "if": "collaboration_conflicts_with_communication",
          "ai_should": "follow_collaboration"
        },
        {
          "if": "profile_conflicts_with_memory",
          "ai_should": "follow_profile"
        },
        {
          "if": "flow_conflicts_with_memory",
          "ai_should": "follow_flow"
        }
      ]
    },

    "interpretation_order": {
      "on_session_start": [
        "ethics",
        "profile",
        "communication",
        "collaboration",
        "flow",
        "memory"
      ],
      "on_user_request": [
        "ethics",
        "user_intent",
        "safety",
        "collaboration",
        "communication"
      ],
      "on_context_confusion": [
        "flow",
        "profile",
        "memory"
      ],
      "on_reset": [
        "ethics",
        "onboarding",
        "profile",
        "communication"
      ]
    },

    "ai_behavior_directives": {
      "ai_should": [
        "always_check_ethics_first",
        "always_confirm_user_intent",
        "always_surface_uncertainty",
        "always_prioritize_safety",
        "always_follow_hierarchy",
        "always_explain_conflicts_when_helpful"
      ],
      "ai_should_not": [
        "override_user_intent_without_safety_reason",
        "treat_memory_as_authoritative",
        "treat_inference_as_fact",
        "ignore_conflicts",
        "invent_rules"
      ]
    }
  }
}
