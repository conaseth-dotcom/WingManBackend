{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "WingMan Partition Configuration Schema",
  "description": "Schema for validating the modern portable partition.config.json",
  "type": "object",

  "required": ["configVersion", "meta", "partitionRoot", "paths", "runtime"],

  "properties": {
    "configVersion": {
      "type": "string"
    },

    "meta": {
      "type": "object",
      "required": ["name", "description", "createdBy", "lastUpdatedBy"],
      "properties": {
        "name": { "type": "string" },
        "description": { "type": "string" },
        "createdBy": { "type": "string" },
        "lastUpdatedBy": { "type": "string" },
        "notes": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },

    "partitionRoot": {
      "type": "string",
      "description": "User-selected root folder for the WingMan partition"
    },

    "paths": {
      "type": "object",
      "required": ["user", "shared", "ai", "system", "runtime", "overlay"],
      "properties": {
        "user":    { "type": "string" },
        "shared":  { "type": "string" },
        "ai":      { "type": "string" },
        "system":  { "type": "string" },
        "runtime": { "type": "string" },
        "overlay": { "type": "string" }
      }
    },

    "runtime": {
      "type": "object",
      "required": ["logsPath", "tempPath", "enforceAbsolutePaths"],
      "properties": {
        "logsPath": { "type": "string" },
        "tempPath": { "type": "string" },
        "enforceAbsolutePaths": { "type": "boolean" },
        "failOnUnknownPartitionId": { "type": "boolean" },
        "failOnUnsafeWrite": { "type": "boolean" }
      }
    }
  }
}
